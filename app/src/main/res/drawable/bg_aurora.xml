<?xml version="1.0" encoding="utf-8"?>
<!-- 沉浸光感 · 极光底图（静态版）：给弹窗/不能加自定义 View 的页面当 windowBackground -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_bg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial"
                android:centerX="0.14" android:centerY="0.06"
                android:gradientRadius="0.55"
                android:startColor="@color/dusk_glow_main" android:endColor="#00FF9A5A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial"
                android:centerX="0.88" android:centerY="0.16"
                android:gradientRadius="0.48"
                android:startColor="@color/dusk_glow_mid" android:endColor="#00FF4E78" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial"
                android:centerX="0.50" android:centerY="1.08"
                android:gradientRadius="0.62"
                android:startColor="@color/dusk_glow_deep" android:endColor="#008A4DFF" />
        </shape>
    </item>
</layer-list>
