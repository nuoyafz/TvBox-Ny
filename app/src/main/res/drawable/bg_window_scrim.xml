<?xml version="1.0" encoding="utf-8"?>
<!--
  窗口遮罩 v5（沉浸光感）
  v4 的错：这层和 AuroraBackgroundView 画的是同一组光斑，两层叠加 → 光斑糊成一整片酒红，
  看着像"换了个纯色底"，不像"光"。
  现在只留一层极光（AuroraBackgroundView），这层退化成极轻的压暗，
  保证白字可读，同时让光斑的边界留得住。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#0D000000"
                android:centerColor="#1F000000"
                android:endColor="#38000000" />
        </shape>
    </item>
</layer-list>
