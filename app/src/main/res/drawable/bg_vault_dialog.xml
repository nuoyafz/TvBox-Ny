<?xml version="1.0" encoding="utf-8"?>
<!--
  沉浸光感 · 弹窗底座（原"放映厅底座"）
  统一烟玻璃：中低不透明度、细描边与柔和顶光。
  窗口 dim 和 Android 12+ backdrop blur 一起保证文字可读，同时让背景保留层次。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10mm" />
            <solid android:color="#98101417" />
            <stroke android:width="1mm" android:color="#36FFFFFF" />
        </shape>
    </item>
    <!-- 顶部受光：玻璃上沿的冷白反光 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10mm" />
            <gradient
                android:angle="270"
                android:type="linear"
                android:startColor="#20FFFFFF"
                android:centerColor="#07DFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
