<?xml version="1.0" encoding="utf-8"?>
<!--
  弹窗工具条胶囊（源检测 / 健康度排序）
  常态：14% 白玻璃 + 1mm 受光边
  焦点：霞橙边 2mm + 24% 白底 —— 和「换源」按钮同一套焦点语言
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="17mm" />
            <solid android:color="#3DFFFFFF" />
            <stroke android:width="2mm" android:color="@color/neon_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="17mm" />
            <solid android:color="#21FFFFFF" />
            <stroke android:width="1mm" android:color="@color/neon_glass_border" />
        </shape>
    </item>
</selector>
