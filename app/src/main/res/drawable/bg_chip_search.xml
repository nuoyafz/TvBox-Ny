<?xml version="1.0" encoding="utf-8"?>
<!--
  顶栏「搜索」胶囊（占位）
  真正的颜色在 ThemeManager.searchChipSelector() 里按当前主题生成，
  这里只是编译期占位 + 万一代码没跑到时的兜底。
  常态：65% 霞橙实心 + 白边；焦点：近白实底 + 霞橙边（反白）。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18mm" />
            <solid android:color="#FDF6F2" />
            <stroke android:width="1.4mm" android:color="@color/neon_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18mm" />
            <solid android:color="#B8D7FF47" />
            <stroke android:width="1.4mm" android:color="#66FFFFFF" />
        </shape>
    </item>
</selector>
