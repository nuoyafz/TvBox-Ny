<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18mm" />
            <solid android:color="#24FFFFFF" />
            <stroke android:width="1.5mm" android:color="@color/neon_accent" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="18mm" />
            <solid android:color="#18FFFFFF" />
            <stroke android:width="1mm" android:color="#66FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18mm" />
            <solid android:color="#0CFFFFFF" />
            <stroke android:width="1mm" android:color="#22FFFFFF" />
        </shape>
    </item>
</selector>
