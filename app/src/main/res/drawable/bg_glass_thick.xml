<?xml version="1.0" encoding="utf-8"?>
<!-- 沉浸光感 · 玻璃面板 BODY：半透白 + 受光边 + 受光高光线 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_thick" />
            <corners android:radius="20mm" />
            <stroke android:width="1mm" android:color="@color/neon_glass_border" />
        </shape>
    </item>
    <item android:gravity="top" android:height="2mm">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="20mm" android:topRightRadius="20mm" />
            <gradient android:angle="270" android:startColor="#59FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
