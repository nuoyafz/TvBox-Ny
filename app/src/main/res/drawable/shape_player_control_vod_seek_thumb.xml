<?xml version="1.0" encoding="utf-8"?>
<!-- 进度条圆点：白实心 + 琥珀描边（原来描边是 Material 粉 #FF4081） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="2dp"
                android:color="@color/neon_accent"/>
            <size
                android:width="12dp"
                android:height="12dp"/>
        </shape>
    </item>
</selector>