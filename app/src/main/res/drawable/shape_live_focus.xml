<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/atv_focus_fill" />
            <stroke android:width="@dimen/atv_stroke_focus" android:color="@color/atv_focus_ring" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="#1FFFFFFF" />
            <stroke android:width="1dp" android:color="@color/atv_divider" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_focused="false">
        <shape>
            <solid android:color="@android:color/transparent" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
