<?xml version="1.0" encoding="utf-8"?>
<!--
  Apple TV 主背景：纯黑基底 + 顶部极轻的冷灰渐变，
  让海报卡片浮起来，而不是靠花哨壁纸。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/atv_bg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FF141418"
                android:centerColor="#FF0A0A0C"
                android:endColor="@color/atv_bg"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
