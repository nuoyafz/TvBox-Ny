<?xml version="1.0" encoding="utf-8"?>
<!--
  首字母预览卡片（右侧结果区，4 列）。

  海报来源：腾讯联想接口只给片名，海报由豆瓣 subject_suggest 按片名补齐（见 SearchActivity.fetchPosters）。
  海报还没回来时先用居中大字顶住，回来后切成海报 + 底部片名，渐进刷新不闪。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/vs_220"
    android:background="@drawable/shape_atv_card"
    android:focusable="true"
    android:padding="@dimen/vs_1">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 海报 -->
        <ImageView
            android:id="@+id/ivPreviewPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- 海报没回来时的占位：居中大字片名 -->
        <TextView
            android:id="@+id/tvPreviewBig"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_preview_poster"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.2"
            android:maxLines="3"
            android:paddingLeft="@dimen/vs_12"
            android:paddingRight="@dimen/vs_12"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_22"
            android:textStyle="bold" />

        <!-- 左上角：当前输入的首字母 -->
        <TextView
            android:id="@+id/tvPreviewIni"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_8"
            android:layout_marginTop="@dimen/vs_8"
            android:background="@drawable/shape_thumb_year"
            android:includeFontPadding="false"
            android:letterSpacing="0.14"
            android:paddingLeft="@dimen/vs_5"
            android:paddingTop="@dimen/vs_1"
            android:paddingRight="@dimen/vs_5"
            android:paddingBottom="@dimen/vs_1"
            android:textColor="@color/neon_accent"
            android:textSize="@dimen/ts_14" />

        <!-- 底部：片名 + 类型年份 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/shape_thumb_bottom_name"
            android:orientation="vertical"
            android:paddingLeft="@dimen/vs_8"
            android:paddingTop="@dimen/vs_5"
            android:paddingRight="@dimen/vs_8"
            android:paddingBottom="@dimen/vs_5">

            <TextView
                android:id="@+id/tvPreviewName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_20" />

            <TextView
                android:id="@+id/tvPreviewMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/neon_text_secondary"
                android:textSize="@dimen/ts_14" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
