<?xml version="1.0" encoding="utf-8"?>
<!--
  搜索页 · 上下分区（画报版 C4）

  旧版是三栏横排（左 420mm 输入+键盘 / 中 240mm 热词 / 右结果），
  llLayout 还写了 match_parent，第三栏实际被挤出屏幕右侧 —— 结构上就是错的。
  现在改成：
    1. 顶部一条：标题 + 输入框 + 搜索/清空/指定源
    2. 中段：键盘（3 行、只字母） + 右侧「猜你想搜 / 搜索历史」
    3. 下半：结果区，吃掉剩余全部高度
  首字母搜索：输入 ZL 即联想「战狼」，确认后在源里搜。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_window_scrim"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingLeft="@dimen/vs_24"
    android:paddingTop="@dimen/vs_20"
    android:paddingRight="@dimen/vs_24"
    android:paddingBottom="@dimen/vs_16">

    <!-- ===== 顶栏 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:text="搜索"
                android:textColor="@color/neon_text_primary"
                android:textSize="@dimen/ts_30"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_4"
                android:includeFontPadding="false"
                android:letterSpacing="0.32"
                android:text="SEARCH"
                android:textColor="@color/neon_accent"
                android:textSize="@dimen/ts_14" />
        </LinearLayout>

        <Space
            android:layout_width="@dimen/vs_20"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0mm"
            android:layout_height="@dimen/vs_56"
            android:layout_weight="1"
            android:background="@drawable/bg_atv_input"
            android:hint="片名 · 演员 · 首字母（ZL 战狼）"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:paddingLeft="@dimen/vs_20"
            android:paddingRight="@dimen/vs_20"
            android:textColor="@color/neon_text_primary"
            android:textColorHint="@color/neon_text_tertiary"
            android:textCursorDrawable="@null"
            android:textSize="@dimen/ts_22"
            tools:ignore="RtlSymmetry" />

        <Space
            android:layout_width="@dimen/vs_10"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvSearch"
            android:layout_width="@dimen/vs_150"
            android:layout_height="@dimen/vs_56"
            android:background="@drawable/button_detail_play"
            android:focusable="true"
            android:gravity="center"
            android:text="搜索"
            android:textColor="@color/atv_btn_text"
            android:textSize="@dimen/ts_22"
            android:textStyle="bold" />

        <Space
            android:layout_width="@dimen/vs_10"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvClear"
            android:layout_width="@dimen/vs_110"
            android:layout_height="@dimen/vs_56"
            android:background="@drawable/shape_atv_key"
            android:focusable="true"
            android:gravity="center"
            android:text="清空"
            android:textColor="@color/atv_row_text"
            android:textSize="@dimen/ts_20" />

        <Space
            android:layout_width="@dimen/vs_10"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvSearchCheckboxBtn"
            android:layout_width="@dimen/vs_170"
            android:layout_height="@dimen/vs_56"
            android:background="@drawable/shape_atv_key"
            android:focusable="true"
            android:gravity="center"
            android:text="指定搜索源"
            android:textColor="@color/atv_row_text"
            android:textSize="@dimen/ts_20" />
    </LinearLayout>

    <!-- ===== 中段：键盘 + 猜你想搜 / 历史 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_16"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0mm"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.github.tvbox.osc.ui.tv.widget.SearchKeyboard
                android:id="@+id/keyBoardRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_6"
                android:layout_marginLeft="@dimen/vs_10"
                android:letterSpacing="0.03"
                android:text="每个字打一个首字母：ZL 战狼 · FH 繁花 · YFX 与凤行"
                android:textColor="@color/neon_text_tertiary"
                android:textSize="@dimen/ts_14" />
        </LinearLayout>

        <Space
            android:layout_width="@dimen/vs_20"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/llWord"
            android:layout_width="0mm"
            android:layout_height="wrap_content"
            android:layout_weight="0.46"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wordSwitch"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/vs_40"
                android:background="@drawable/shape_atv_key"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="@dimen/vs_140"
                android:paddingLeft="@dimen/vs_20"
                android:paddingRight="@dimen/vs_20"
                android:text="猜你想搜"
                android:textColor="@color/atv_row_text"
                android:textSize="@dimen/ts_16" />

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mGridViewWord"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_150"
                android:layout_marginTop="@dimen/vs_10"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_6"
                app:tv_selectedItemIsCentered="false"
                app:tv_verticalSpacingWithMargins="@dimen/vs_6" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llHistoryWord"
            android:layout_width="0mm"
            android:layout_height="wrap_content"
            android:layout_weight="0.46"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_40"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvHistoryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:text="搜索历史"
                    android:textColor="@color/neon_text_primary"
                    android:textSize="@dimen/ts_20"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="0mm"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/tvHistoryClear"
                    android:layout_width="@dimen/vs_40"
                    android:layout_height="@dimen/vs_40"
                    android:alpha="0.75"
                    android:background="@drawable/shape_atv_key"
                    android:focusable="true"
                    android:padding="@dimen/vs_10"
                    android:src="@drawable/icon_delete" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/historyWordGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_8"
                android:columnCount="1"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/remoteRoot"
            android:layout_width="0mm"
            android:layout_height="wrap_content"
            android:layout_weight="0.46"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:lineSpacingMultiplier="1.4"
                android:textColor="@color/atv_text_secondary"
                android:textSize="@dimen/ts_16" />

            <ImageView
                android:id="@+id/ivQRCode"
                android:layout_width="160mm"
                android:layout_height="160mm"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12mm"
                tools:ignore="InOrMmUsage" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 结果区 ===== -->
    <LinearLayout
        android:id="@+id/llLayout"
        android:layout_width="match_parent"
        android:layout_height="0mm"
        android:layout_marginTop="@dimen/vs_10"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_30"
            android:layout_marginBottom="@dimen/vs_10"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:text="搜索结果"
                android:textColor="@color/neon_text_primary"
                android:textSize="@dimen/ts_22"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_12"
                android:includeFontPadding="false"
                android:letterSpacing="0.3"
                android:text="RESULTS"
                android:textColor="@color/neon_accent"
                android:textSize="@dimen/ts_14" />
        </LinearLayout>

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridView"
            android:layout_width="match_parent"
            android:layout_height="0mm"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="invisible"
            app:tv_horizontalSpacingWithMargins="@dimen/vs_5"
            app:tv_selectedItemIsCentered="false"
            app:tv_verticalSpacingWithMargins="@dimen/vs_5" />
    </LinearLayout>
</LinearLayout>
