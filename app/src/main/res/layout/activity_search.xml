<?xml version="1.0" encoding="utf-8"?>
<!--
  搜索页 · 左右分栏（C5）

  左边 45%：标题 + 输入框 + 键盘 + 猜你想搜 + 历史搜索，一列到底，不再铺满整屏。
  右边 55%：结果预览区，一屏 5 列 × 3 排 = 15 部。

  为什么不上下分区：电视 16:9，上下分区时键盘横跨整屏，右半边那一截纯属浪费；
  改成左右后键盘只占左半边，右边能一次性铺出 15 部候选，打字即预览。

  键盘仍是 3 行 10 列（A-Z 26 格 + 删除 2 格 + 远程搜索 2 格 = 30 格，正好 3 行）。
  「猜你想搜」和「历史搜索」现在同屏常驻，不再靠一个按钮来回切。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_window_scrim"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/vs_30"
    android:paddingTop="@dimen/vs_20"
    android:paddingRight="@dimen/vs_30"
    android:paddingBottom="@dimen/vs_16">

    <!-- ==================== 左栏：输入 + 键盘 + 词 ==================== -->
    <LinearLayout
        android:layout_width="0mm"
        android:layout_height="match_parent"
        android:layout_weight="45"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingRight="@dimen/vs_26">

        <!-- 标题 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="搜索"
                android:textColor="@color/neon_text_primary"
                android:textSize="@dimen/ts_30"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_10"
                android:includeFontPadding="false"
                android:letterSpacing="0.32"
                android:text="SEARCH"
                android:textColor="@color/neon_accent"
                android:textSize="@dimen/ts_14" />
        </LinearLayout>

        <!-- 输入框 + 搜索 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_64"
            android:layout_marginTop="@dimen/vs_14"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0mm"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_atv_input"
                android:hint="片名 · 演员 · 首字母 ZL"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:paddingLeft="@dimen/vs_18"
                android:paddingRight="@dimen/vs_18"
                android:textColor="@color/neon_text_primary"
                android:textColorHint="@color/neon_text_tertiary"
                android:textCursorDrawable="@null"
                android:textSize="@dimen/ts_22"
                tools:ignore="RtlSymmetry" />

            <TextView
                android:id="@+id/tvSearch"
                android:layout_width="@dimen/vs_100"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/vs_8"
                android:background="@drawable/button_detail_play"
                android:focusable="true"
                android:gravity="center"
                android:text="搜索"
                android:textColor="@color/atv_btn_text"
                android:textSize="@dimen/ts_20"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 键盘 -->
        <com.github.tvbox.osc.ui.tv.widget.SearchKeyboard
            android:id="@+id/keyBoardRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10" />

        <!-- 首字母提示 + 清空 + 指定源（塞同一行，不额外占高度） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_36"
            android:layout_marginTop="@dimen/vs_6"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0mm"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="0.02"
                android:singleLine="true"
                android:text="每个字打一个首字母：ZL 战狼 · FH 繁花"
                android:textColor="@color/neon_text_tertiary"
                android:textSize="@dimen/ts_14" />

            <TextView
                android:id="@+id/tvClear"
                android:layout_width="@dimen/vs_76"
                android:layout_height="@dimen/vs_35"
                android:layout_marginLeft="@dimen/vs_6"
                android:background="@drawable/shape_atv_key"
                android:focusable="true"
                android:gravity="center"
                android:text="清空"
                android:textColor="@color/atv_row_text"
                android:textSize="@dimen/ts_16" />

            <TextView
                android:id="@+id/tvSearchCheckboxBtn"
                android:layout_width="@dimen/vs_105"
                android:layout_height="@dimen/vs_35"
                android:layout_marginLeft="@dimen/vs_6"
                android:background="@drawable/shape_atv_key"
                android:focusable="true"
                android:gravity="center"
                android:text="指定源"
                android:textColor="@color/atv_row_text"
                android:textSize="@dimen/ts_16" />
        </LinearLayout>

        <!-- 猜你想搜（8 个 · 2 列 × 4 行） -->
        <LinearLayout
            android:id="@+id/llWord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_14"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wordSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:includeFontPadding="false"
                android:letterSpacing="0.18"
                android:text="猜你想搜"
                android:textColor="@color/neon_text_tertiary"
                android:textSize="@dimen/ts_16" />

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mGridViewWord"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_220"
                android:layout_marginTop="@dimen/vs_6"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_5"
                app:tv_selectedItemIsCentered="false"
                app:tv_verticalSpacingWithMargins="@dimen/vs_5" />
        </LinearLayout>

        <!-- 历史搜索（常驻 · 2 列 × 3 行） -->
        <LinearLayout
            android:id="@+id/llHistoryWord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_35"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvHistoryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.18"
                    android:text="历史搜索"
                    android:textColor="@color/neon_text_tertiary"
                    android:textSize="@dimen/ts_16" />

                <Space
                    android:layout_width="0mm"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvHistoryClear"
                    android:layout_width="@dimen/vs_76"
                    android:layout_height="@dimen/vs_35"
                    android:alpha="0.7"
                    android:background="@drawable/shape_atv_key"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:text="清空"
                    android:textColor="@color/atv_row_text"
                    android:textSize="@dimen/ts_16" />
            </LinearLayout>

            <!-- columnCount 必须是 1：代码里是手动 addView 整行 LinearLayout 再横向排列，
                 写成 2 会把每个 MATCH_PARENT 的行塞进半列，直接挤扁。 -->
            <GridLayout
                android:id="@+id/historyWordGrid"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_150"
                android:layout_marginTop="@dimen/vs_4"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:columnCount="1" />
        </LinearLayout>

        <!-- 远程搜索（扫码），仍在，平时隐藏 -->
        <LinearLayout
            android:id="@+id/remoteRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:lineSpacingMultiplier="1.4"
                android:textColor="@color/atv_text_secondary"
                android:textSize="@dimen/ts_16" />

            <ImageView
                android:id="@+id/ivQRCode"
                android:layout_width="160mm"
                android:layout_height="160mm"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12mm"
                tools:ignore="InOrMmUsage" />
        </LinearLayout>
    </LinearLayout>

    <!-- 竖分隔线 -->
    <View
        android:layout_width="1mm"
        android:layout_height="match_parent"
        android:background="@color/neon_divider" />

    <!-- ==================== 右栏：结果预览 ==================== -->
    <LinearLayout
        android:layout_width="0mm"
        android:layout_height="match_parent"
        android:layout_weight="55"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_26"
        android:paddingRight="@dimen/vs_26">

        <LinearLayout
            android:id="@+id/llLayout"
            android:layout_width="match_parent"
            android:layout_height="0mm"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_36"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvResultTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.04"
                    android:text="今晚看什么"
                    android:textColor="@color/neon_text_primary"
                    android:textSize="@dimen/ts_22"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvResultCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/vs_10"
                    android:includeFontPadding="false"
                    android:textColor="@color/neon_text_tertiary"
                    android:textSize="@dimen/ts_14" />

                <Space
                    android:layout_width="0mm"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.3"
                    android:text="RESULTS"
                    android:textColor="@color/neon_accent"
                    android:textSize="@dimen/ts_14" />
            </LinearLayout>

            <!-- 三个视图叠在同一位：真实结果 / 首字母预览 / 空态，代码里切可见性 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0mm"
                android:layout_marginTop="@dimen/vs_10"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">

                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:id="@+id/mGridView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:visibility="invisible"
                    app:tv_horizontalSpacingWithMargins="@dimen/vs_5"
                    app:tv_selectedItemIsCentered="false"
                    app:tv_verticalSpacingWithMargins="@dimen/vs_5" />

                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:id="@+id/previewGrid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:visibility="gone"
                    app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
                    app:tv_selectedItemIsCentered="false"
                    app:tv_verticalSpacingWithMargins="@dimen/vs_10" />

                <TextView
                    android:id="@+id/tvResultEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.7"
                    android:text="左边打首字母\n右边立刻出候选"
                    android:textColor="@color/neon_text_tertiary"
                    android:textSize="@dimen/ts_18" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
