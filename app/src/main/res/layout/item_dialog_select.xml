<?xml version="1.0" encoding="utf-8"?>
<!-- Netflix 资料选择器风：品牌色块大卡 + 卡下灰字小注，选中白粗环 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/signRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/selector_poster_card"
    android:layout_margin="@dimen/vs_5"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/signPanel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_110">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:paddingLeft="@dimen/vs_8"
            android:paddingRight="@dimen/vs_8"
            android:singleLine="true"
            android:textColor="@color/neon_text_primary"
            android:textSize="@dimen/ts_26"
            android:textStyle="bold"
            tools:text="文采" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvSignCap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_8"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="@color/neon_text_secondary"
        android:textSize="@dimen/ts_16"
        tools:text="秒播" />
</LinearLayout>
