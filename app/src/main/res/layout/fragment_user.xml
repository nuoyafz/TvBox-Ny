<?xml version="1.0" encoding="utf-8"?>
<!-- 首页频道舞台：继续观看主视觉 + 横向宽银幕推荐条。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="-92mm"
        android:layout_marginEnd="-18mm"
        android:layout_marginRight="-18mm"
        android:alpha="0.045"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:text="01"
        android:textColor="@color/neon_text_primary"
        android:textSize="430mm"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_marginTop="-30mm"
        android:layout_marginRight="-16mm"
        android:alpha="0.025"
        android:includeFontPadding="false"
        android:letterSpacing="0.02"
        android:singleLine="true"
        android:text="NOYA"
        android:textColor="@color/neon_text_primary"
        android:textSize="150mm"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingLeft="62mm"
        android:paddingRight="62mm">

        <!--
          主视觉吃掉所有弹性空间（weight=1），片单区固定高度。
        -->
        <LinearLayout
            android:id="@+id/tvHeroBlock"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="0mm"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- 左侧主标题与继续播放操作 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="16mm"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingLeft="8mm"
                android:paddingTop="12mm"
                android:paddingRight="8mm"
                android:paddingBottom="12mm">

                <TextView
                    android:id="@+id/tvHeroKicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.18"
                    android:text="今晚接着看　/　CONTINUE"
                    android:textColor="@color/neon_accent"
                    android:textSize="13mm" />

                <TextView
                    android:id="@+id/tvHeroTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12mm"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="2"
                    android:textColor="@color/neon_text_primary"
                    android:textSize="58mm"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeroMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10mm"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.03"
                    android:maxLines="1"
                    android:textColor="@color/neon_text_secondary"
                    android:textSize="16mm" />

                <TextView
                    android:id="@+id/tvHeroDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12mm"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3mm"
                    android:maxLines="2"
                    android:textColor="@color/neon_text_secondary"
                    android:textSize="14mm"
                    android:visibility="gone" />

                <View
                    android:layout_width="44mm"
                    android:layout_height="3mm"
                    android:layout_marginTop="15mm"
                    android:background="@color/neon_accent" />

                <TextView
                    android:id="@+id/tvHeroPlay"
                    android:layout_width="wrap_content"
                    android:layout_height="46mm"
                    android:layout_marginTop="16mm"
                    android:background="@drawable/button_detail_play"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.04"
                    android:paddingLeft="24mm"
                    android:paddingRight="24mm"
                    android:text="▶　继续播放"
                    android:textColor="@color/neon_bg"
                    android:textSize="16mm" />

            </LinearLayout>

            <!-- 右侧实体海报与播放集数 -->
            <FrameLayout
                android:id="@+id/heroPosterBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="38mm"
                android:layout_marginLeft="38mm"
                android:background="@color/neon_accent"
                android:padding="3mm"
                android:rotation="2">

                <ImageView
                    android:id="@+id/ivHeroPoster"
                    android:layout_width="245mm"
                    android:layout_height="342mm"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/tvHeroEp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8mm"
                    android:layout_marginEnd="8mm"
                    android:layout_marginRight="8mm"
                    android:background="@color/neon_accent"
                    android:includeFontPadding="false"
                    android:paddingLeft="10mm"
                    android:paddingTop="4mm"
                    android:paddingRight="10mm"
                    android:paddingBottom="4mm"
                    android:textColor="@color/neon_bg"
                    android:textSize="16mm"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42mm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="24mm"
                android:layout_height="2mm"
                android:background="@color/neon_accent" />

            <TextView
                android:id="@+id/tvRowLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12mm"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:text="接下来放什么"
                android:textColor="@color/neon_text_primary"
                android:textSize="19mm"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvRowAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_text_link"
                android:clickable="true"
                android:focusable="true"
                android:includeFontPadding="false"
                android:letterSpacing="0.12"
                android:text="全部历史　→"
                android:textColor="@color/neon_accent"
                android:textSize="14mm" />

        </LinearLayout>

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/tvHotList"
            android:layout_width="match_parent"
            android:layout_height="112mm"
            android:layout_marginTop="5mm"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone"
            app:tv_horizontalSpacingWithMargins="10mm"
            app:tv_selectedItemIsCentered="false" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="9mm" />

    </LinearLayout>

</FrameLayout>
