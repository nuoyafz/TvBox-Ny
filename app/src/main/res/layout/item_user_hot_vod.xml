<?xml version="1.0" encoding="utf-8"?>
<!-- 首页横向宽银幕推荐卡片。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/selector_poster_card"
    android:focusable="true"
    android:nextFocusUp="@id/tvHeroPlay"
    android:padding="2mm">

    <FrameLayout
        android:id="@+id/mItemFrame"
        android:layout_width="188mm"
        android:layout_height="100mm"
        android:background="@drawable/shape_media_card"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/ivThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="70mm"
            android:layout_gravity="bottom"
            android:background="@drawable/shape_poster_scrim" />

        <TextView
            android:id="@+id/tvRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10mm"
            android:layout_marginTop="9mm"
            android:alpha="0.92"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:textColor="@color/neon_text_primary"
            android:textSize="11mm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingLeft="10mm"
            android:paddingRight="10mm"
            android:paddingBottom="9mm">

            <TextView
                android:id="@+id/tvNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2mm"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:textColor="@color/neon_text_secondary"
                android:textSize="10mm" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:text="Title"
                android:textColor="@color/neon_text_primary"
                android:textSize="14mm"
                android:textStyle="bold" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/delFrameLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shape_user_delete"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="60mm"
                android:layout_height="60mm"
                android:layout_gravity="center"
                android:src="@drawable/icon_delete" />

        </FrameLayout>

    </FrameLayout>

</FrameLayout>
