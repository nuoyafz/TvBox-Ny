<?xml version="1.0" encoding="utf-8"?>
<!--
  快速搜索的窄行项。
  旧版只有描边、文字固定白色，焦点时也不反色。
  新版走列表行语言：焦点整行纯白、文字翻黑。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/vs_4"
    android:background="@drawable/shape_atv_row"
    android:focusable="true">

    <TextView
        android:id="@+id/tvName"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_64"
        android:duplicateParentState="true"
        android:ellipsize="middle"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/vs_16"
        android:paddingRight="@dimen/vs_16"
        android:singleLine="true"
        android:textColor="@color/atv_row_text"
        android:textSize="@dimen/ts_20" />
</FrameLayout>
