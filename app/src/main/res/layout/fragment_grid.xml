<?xml version="1.0" encoding="utf-8"?>
<!--
  分类选片页 · 沉浸版
  聚光区已整体移除（用户要求"取消红框部分"），网格全屏铺满。
  沉静感来源：页面纯黑底 + 卡片非焦点压暗去色（GridAdapter DIM_FILTER）。
  mGridView 仍被 LoadSir 原地包裹，换源复制逻辑不受影响。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neon_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/gridContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingLeft="@dimen/vs_40"
            android:paddingTop="@dimen/vs_24"
            android:paddingRight="@dimen/vs_40"
            android:paddingBottom="@dimen/vs_20"
            app:tv_horizontalSpacingWithMargins="@dimen/vs_16"
            app:tv_selectedItemIsCentered="true"
            app:tv_verticalSpacingWithMargins="@dimen/vs_20" />
    </FrameLayout>
</LinearLayout>
