<?xml version="1.0" encoding="utf-8"?>
<!--
  「手机接着看」弹窗：左边二维码，右边说明 + 可复制的局域网地址。
  样式与 ApiDialog / DanmuApiDialog 同一套（shape_danmu_setting_bg + 米白字 + 琥珀强调）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_danmu_setting_bg"
        android:orientation="horizontal"
        android:padding="@dimen/vs_35">

        <ImageView
            android:id="@+id/ivQRCode"
            android:layout_width="@dimen/vs_300"
            android:layout_height="@dimen/vs_300"
            android:layout_gravity="center_vertical"
            android:focusable="false"
            android:contentDescription="手机播放二维码" />

        <LinearLayout
            android:layout_width="@dimen/vs_520"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/vs_36"
            android:layout_marginLeft="@dimen/vs_36"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:text="手机接着看"
                android:textColor="@color/neon_text_primary"
                android:textSize="@dimen/ts_30"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_12"
                android:lineSpacingMultiplier="1.4"
                android:text="默认走电视中转：防盗链源也能播，手机要和电视同一 WiFi。\n部分源带防盗链，直链在手机浏览器可能 403 打不开——那种就保持中转模式。"
                android:textColor="@color/neon_text_tertiary"
                android:textSize="@dimen/ts_14" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_22"
                android:includeFontPadding="false"
                android:letterSpacing="0.16"
                android:text="扫码打不开就手动输入"
                android:textColor="@color/neon_text_tertiary"
                android:textSize="@dimen/ts_10" />

            <TextView
                android:id="@+id/tvMobileUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_6"
                android:lineSpacingMultiplier="1.3"
                android:breakStrategy="simple"
                android:textColor="@color/neon_accent"
                android:textIsSelectable="true"
                android:textSize="@dimen/ts_14" />

            <!-- 直链/中转双模式：中转能播但要同一 WiFi，直链免 WiFi 但防盗链源可能 403 -->
            <TextView
                android:id="@+id/tvMobileMode"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/vs_40"
                android:layout_marginTop="@dimen/vs_18"
                android:background="@drawable/shape_atv_key"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:paddingLeft="@dimen/vs_18"
                android:paddingRight="@dimen/vs_18"
                android:text="模式：中转 · 按 OK 切直链"
                android:textColor="@color/neon_text_primary"
                android:textSize="@dimen/ts_14" />

            <TextView
                android:id="@+id/tvMobileClose"
                android:layout_width="@dimen/vs_120"
                android:layout_height="@dimen/vs_40"
                android:layout_marginTop="@dimen/vs_26"
                android:background="@drawable/button_dialog_main"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:text="关闭"
                android:textColor="@color/neon_text_primary"
                android:textSize="@dimen/ts_16" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
