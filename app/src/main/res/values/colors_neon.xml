    <!--
      顶栏文字（用户反馈"导航栏字体和颜色很不匹配"）
      原来的 #B3A3A8 是暖灰粉，压在霞橙天空上又脏又糊，读不出层级。
      顶栏一律改近白，靠字重/字距做层次，不靠灰度。
    -->
    <color name="top_link_text">#F2FDF6F2</color>
    <color name="top_link_text_dim">#CCFDF6F2</color>

    <color name="neon_glass">#1FFFFFFF</color>
