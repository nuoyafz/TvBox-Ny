<?xml version="1.0" encoding="utf-8"?>
<!--
  导航项文字：顶栏分类 / 源名 / 搜索入口 / 设置页左栏分组。

  当前主题（日落大道）顶栏底下是霞橙天空，原来常态用 #B3A3A8（暖灰粉），
  压上去又脏又糊，和纯白的 NOYA 不是一个体系 —— 这就是"字体和颜色很不匹配"。
  现在常态提到 85% 暖白，靠字距和字重做层次；焦点仍是纯白 + 下划线。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#FFFFFFFF" />
    <item android:color="#D9FDF6F2" />
</selector>
